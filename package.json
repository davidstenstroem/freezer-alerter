{
  "name": "freezer-alerter",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf dist node_modules",
    "dev": "pnpm env:run tsx watch src/main.ts",
    "env:run": "dotenv --",
    "format": "prettier -w . --ignore-path .gitignore --ignore-path .prettierignore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "pnpm env:run node dist/main.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "^24",
    "dotenv-cli": "11.0.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "prettier-plugin-pkg": "0.22.1",
    "semantic-release": "25.0.7",
    "tsdown": "0.22.5",
    "tsx": "4.23.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  }
}
