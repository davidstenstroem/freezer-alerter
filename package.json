{
  "name": "freezer-alerter",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba",
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf dist node_modules",
    "dev": "pnpm env:run tsx watch src/main.ts",
    "env:run": "dotenv --",
    "format": "prettier -w . --ignore-path .gitignore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "pnpm env:run node dist/main.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/node": "^24",
    "dotenv-cli": "11.0.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "prettier-plugin-pkg": "0.22.1",
    "tsdown": "0.22.5",
    "tsx": "4.23.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  }
}
